<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_accounting_tab" model="ir.ui.view">
        <field name="name">Partners</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/> <!-- Reference to existing view -->
        <field name="arch" type="xml">
            <!-- Here you insert your new page -->
            <xpath expr="//field[@name='bank_ids']/tree" position="replace">
              <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="bank_id"/>
                                        <field name="iban_custom"/>
                                        <field name="acc_number"/>
                                        <field name="allow_out_payment" widget="boolean_toggle"/>
                                        <field name="acc_holder_name" invisible="1"/>
                </tree>
            </xpath>
        </field>
    </record>




</odoo>

