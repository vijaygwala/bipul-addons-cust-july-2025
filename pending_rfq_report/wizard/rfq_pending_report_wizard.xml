<odoo>
    <record id="view_pending_rfq_report" model="ir.ui.view">
        <field name="name">pending.rfq.wizard.form</field>
        <field name="model">pending.rfq.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Criteria's">
              
                <group>
                    <separator string="Select Criteria's" colspan="4"/>
                      <group>
                        
                        
                        <field name="from_date" string="Start Date" required="1" />
                         <field name="to_date" string="End Date" required="1" />
                         <field name="state" string="State" required="1" />
                        
                    </group>
                 
                    

                   
                    
                </group>
                <footer>
                    <button string="Generate PDF Report" type="object" name="action_print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
</odoo>

