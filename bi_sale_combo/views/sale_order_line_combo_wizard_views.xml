    <record id="view_sale_order_line_combo_wizard" model="ir.ui.view">
        <field name="name">sale.order.line.combo.wizard.form</field>
        <field name="model">sale.order.line.combo.wizard</field>
        <field name="arch" type="xml">
            <form string="Configure Combo">
                <sheet>
                    <group>
                        <field name="required_pack_line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                            </tree>
                        </field>
                    </group>
                    <group>
                        <field name="optional_pack_line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="qty"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>