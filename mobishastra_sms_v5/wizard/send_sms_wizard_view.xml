<odoo>
    <record id="view_send_sms_wizard_form" model="ir.ui.view">
        <field name="name">send.sms.wizard.form</field>
        <field name="model">send.sms.wizard</field>
        <field name="arch" type="xml">
            <form string="Send SMS">
                <group>
                    <field name="mobile"/>
                    <field name="message"/>
                    <field name="use_promotional"/>
                </group>
                <footer>
                    <button string="Send" name="action_send_sms" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>