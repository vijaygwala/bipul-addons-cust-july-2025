<odoo>
    <!-- Tree View -->
    <record id="view_mobishastra_sms_log_tree" model="ir.ui.view">
        <field name="name">mobishastra.sms.log.tree</field>
        <field name="model">mobishastra.sms.log</field>
        <field name="arch" type="xml">
            <tree string="SMS Logs" create="false" delete="false">
                <field name="create_date"/>
                <field name="mobile"/>
                <field name="route"/>
                <field name="status" widget="badge" options="{'class_field': 'status'}"/>
                <field name="created_by"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mobishastra_sms_log_form" model="ir.ui.view">
        <field name="name">mobishastra.sms.log.form</field>
        <field name="model">mobishastra.sms.log</field>
        <field name="arch" type="xml">
            <form string="SMS Log">
                <sheet>
                    <group>
                        <field name="mobile" readonly="1"/>
                        <field name="route" readonly="1" />
                        <field name="status" readonly="1" />
                        <field name="status_code" readonly="1" />
                        <field name="created_by" readonly="1" />
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="message" readonly="1" />
                        <field name="response_text" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mobishastra_sms_log" model="ir.actions.act_window">
        <field name="name">SMS Logs</field>
        <field name="res_model">mobishastra.sms.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_mobishastra_root" name="Mobishastra" sequence="10"/>
    <menuitem id="menu_mobishastra_sms_log"
              name="SMS Logs"
              parent="menu_mobishastra_root"
              action="action_mobishastra_sms_log"
              sequence="20"/>


    <menuitem id="menu_mobishastra_config_root" name="Mobishastra Configuration"  parent="menu_mobishastra_root" action="action_mobishastra_config_wizard" sequence="30"/>
</odoo>