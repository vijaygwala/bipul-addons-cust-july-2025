<odoo>
    <record id="view_partner_form_inherit_mobishastra" model="ir.ui.view">
        <field name="name">res.partner.form.mobishastra</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_sms_wizard"
                            type="object"
                            string="Send SMS"
                            class="btn-primary"
                            icon="fa-comments"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>



