<odoo>
    <record id="view_crm_lead_form_inherit_mobishastra" model="ir.ui.view">
        <field name="name">crm.lead.form.mobishastra</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_sms_wizard" type="object" string="Send SMS" icon="fa-comments" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>