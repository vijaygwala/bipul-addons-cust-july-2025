<?xml version="1.0"?>
<odoo>

	<record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//h2[@name='pos_interface']" position="before">
                <h2>SalesPerson</h2>
				<div class="row mt16 o_settings_container" id="session_config">
					<div class="col-xs-12 col-md-6 o_setting_box">
						<div class="o_setting_left_pane">
							<field name="pos_enable_salesperson"/>
						</div>
						<div class="o_setting_right_pane">
							<label for="pos_enable_salesperson"/>
							<div class="text-muted">
								Salesperson on Orderline
							</div>
						</div>
					</div>	
				</div>
            </xpath>
        </field>
    </record>

	<record model="ir.ui.view" id="pos_order_inherit">
		<field name="name">pos.order.view.form</field>
		<field name="model">pos.order</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='lines']/tree/field[@name='qty']" position="after">
				<field name="sales_person_id"/>
			</xpath>
		</field>
	</record>

	<record model="ir.ui.view" id="pos_order_pivot_inherit">
		<field name="name">pos.order.view.form</field>
		<field name="model">report.pos.order</field>
		<field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='order_id']" position="after">
				<field name="sales_person_id"/>
			</xpath>
		</field>
	</record>
</odoo>
