<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//h2[@name='pos_interface']" position="before">
                    <h2 name="pos_tag">POS SalePerson Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="allow_cashier"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="allow_cashier" string='Set cashier on pos order lines'/>
                            </div>
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <field name="allow_user_ids" widget="many2many_tags" attrs="{'invisible': [('allow_cashier', '=', False)],'required': [('allow_cashier', '=', True)]}"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="pos_sale_order_inherit">
            <field name="name">pos.order.view.form</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <field name="pack_lot_ids" position="before">
                    <field name="customer_id"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
